{
  "name": "ns-gadget-hub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "build:check": "NEXT_DIST_DIR=.next-check next build",
    "start:check": "NEXT_DIST_DIR=.next-check next start",
    "start": "UV_THREADPOOL_SIZE=${UV_THREADPOOL_SIZE:-16} next start",
    "lint": "next lint",
    "check:auth": "node --env-file=.env scripts/auth-check.mjs",
    "check:journey": "node --env-file=.env scripts/journey-check.mjs",
    "check:cloudinary": "node --env-file=.env scripts/cloudinary-check.mjs",
    "check:mail": "node --env-file=.env scripts/mail-check.mjs",
    "role": "node --env-file=.env scripts/set-role.mjs",
    "seed": "node --env-file=.env scripts/seed-products.mjs"
  },
  "dependencies": {
    "axios": "^1.17.0",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.10.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.6.3",
    "next": "^15.5.19",
    "nodemailer": "^10.1.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-hot-toast": "^2.5.1",
    "stripe": "^22.2.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^9",
    "eslint-config-next": "^15.5.19",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.9.3"
  }
}
