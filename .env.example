# --- Auth ---
# openssl rand -base64 48   (minimum 32 characters)
JWT_SECRET=

# Session lifetime in minutes (default 10080 = 7 days when unset).
# Active sessions slide: /api/auth/me re-issues the cookie past half-life.
SESSION_TTL_MINUTES=

# --- App ---
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_CURRENCY=

# --- Password reset email (Gmail SMTP: use an App Password, not your login) ---
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Payments (no fallbacks in code: unset means that method is disabled) ---
STRIPE_SECRET_KEY=
KHALTI_SECRET_KEY=
ESEWA_MERCHANT_CODE=
ESEWA_SECRET_KEY=

MONGODB_URI=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Concurrency ---
# scrypt password hashing runs on the libuv threadpool; the default of 4 caps
# login throughput well below what the CPU can do. npm start sets 16 unless
# this is already set. Match it to available cores.
UV_THREADPOOL_SIZE=16
# Mongo connections per instance. Lower it for wide serverless fan-out, where
# many instances each hold their own pool against one cluster.
MONGODB_MAX_POOL_SIZE=100
# scrypt cost. Stored per hash, so changing it never invalidates existing
# passwords. 32768 measured at ~80 logins/sec on 12 cores; halving roughly
# doubles throughput and halves attacker cost. Minimum 16384, power of two.
SCRYPT_COST_N=32768
